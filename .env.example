# Server-only Firebase configuration.
FIREBASE_PROJECT_ID=avx-crm-509a3
# Local development: absolute path to the private JSON. Keep it out of Git.
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/avx-crm.json"
# Netlify: omit GOOGLE_APPLICATION_CREDENTIALS and instead set this as a secret:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
APP_ORIGIN=http://localhost:3000

# Optional isolated workspace (default: primary)
# AVX_WORKSPACE_ID=primary
# Optional local private file directory (default: .data/files)
# AVX_BLOB_DIR=/absolute/private/path

# Optional receipt email
# RESEND_API_KEY=
# EMAIL_FROM=
# OWNER_COPY_EMAIL=

# Set only behind a trusted proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=true

# Legacy import only; the web app does not use PostgreSQL.
# DATABASE_URL=
# PGLITE_DATA_DIR=/absolute/path/to/legacy/.data/avx
