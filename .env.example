# Development: omit DATABASE_URL for persistent embedded PostgreSQL in .data/avx.
# Production: required. Use a restricted runtime role, never a Supabase service-role key in the browser.
DATABASE_URL=
# Migration/owner CLI only; never give this credential to the web process.
DATABASE_ADMIN_URL=
APP_ORIGIN=http://localhost:3000
# Set to a dedicated, writable absolute directory for local development.
PGLITE_DATA_DIR=.data/avx
# Resend is optional. No emails are simulated.
RESEND_API_KEY=
EMAIL_FROM=
OWNER_COPY_EMAIL=
# Set only if a trusted reverse proxy overwrites the incoming client IP header.
TRUST_PROXY=false
