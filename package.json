{
  "name": "avx-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore --project demo-avx-tests \"npm run test:unit\"",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/migrate.ts",
    "owner:create": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/owner.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src scripts tests docs README.md *.json *.ts *.mjs",
    "format:check": "prettier --check src scripts tests docs README.md *.json *.ts *.mjs",
    "owner:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/owner-setup.ts",
    "owner:reset": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/owner-setup.ts",
    "firebase:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/firebase-check.ts",
    "test:unit": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:import-legacy-setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/import-legacy-setup.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@hookform/resolvers": "7.0.7",
    "@netlify/blobs": "11.1.9",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-dialog": "1.3.1",
    "clsx": "2.1.1",
    "firebase-admin": "14.5.1",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "15.36.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
